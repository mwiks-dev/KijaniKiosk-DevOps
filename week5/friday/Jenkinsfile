pipeline {

    agent {
        docker {
            image 'node:18-alpine'
            args '-v /tmp:/tmp'
        }
    }

    environment {
        NODE_ENV  = 'test'
        BUILD_DIR = 'dist'
        APP_NAME  = 'kijanikiosk-payment'
        GIT_SHORT = "${env.GIT_COMMIT.take(7)}"
        NEXUS_URL = 'http://13.245.143.159:8081/repository/npm-kijanikiosk'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Initialize') {
            steps {
                dir('week5/friday/kijanikiosk-payment') {
                    script {
                        env.PKG_VERSION = sh(
                            script: "node -p \"require('./package.json').version\"",
                            returnStdout: true
                        ).trim()

                        env.ARTIFACT_VERSION =
                            "${env.PKG_VERSION}-${env.GIT_SHORT}"

                        echo "Package version: ${env.PKG_VERSION}"
                        echo "Git commit: ${env.GIT_SHORT}"
                        echo "Artifact version: ${env.ARTIFACT_VERSION}"
                    }
                }
            }
        }

        stage('Lint') {
            steps {
                dir('week5/friday/kijanikiosk-payment') {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir('week5/friday/kijanikiosk-payment') {
                    sh 'npm run build'

                    sh '''
                        set -e

                        test -d "${BUILD_DIR}" || {
                            echo "ERROR: build directory not found"
                            exit 1
                        }

                        echo "Build output:"
                        find "${BUILD_DIR}" -type f
                    '''

                    stash name: 'build-output',
                          includes: 'kijanikiosk-payment/dist/**,kijanikiosk-payment/package.json,kijanikiosk-payment/package-lock.json'
                }
            }
        }

        stage('Verify') {

            parallel {

                stage('Test') {
                    steps {
                        dir('week5/friday/kijanikiosk-payment') {
                            sh '''
                                set -e
                                npm test
                            '''
                        }
                    }

                    post {
                        always {
                            junit(
                                allowEmptyResults: true,
                                testResults: 'kijanikiosk-payment/test-results/*.xml'
                            )
                        }
                    }
                }

                stage('Security Audit') {
                    steps {
                        dir('week5/friday/kijanikiosk-payment') {
                            sh 'npm audit --audit-level=high'
                        }
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                unstash 'build-output'

                archiveArtifacts(
                    artifacts: 'kijanikiosk-payment/dist/**',
                    fingerprint: true,
                    onlyIfSuccessful: true
                )
            }
        }

        stage('Publish') {
            steps {

                dir('week5/friday/kijanikiosk-payment') {

                    unstash 'build-output'

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASS'
                        )
                    ]) {

                        sh '''
                            set -e

                            trap 'rm -f .npmrc' EXIT

                            NEXUS_TOKEN=$(printf '%s:%s' \
                                "${NEXUS_USER}" \
                                "${NEXUS_PASS}" | base64 | tr -d '\\n')

                            cat > .npmrc <<EOF
registry=${NEXUS_URL}
//13.245.143.159:8081/repository/npm-kijanikiosk/:_authToken=${NEXUS_TOKEN}
always-auth=true
EOF

                            npm version "${ARTIFACT_VERSION}" \
                                --no-git-tag-version \
                                --allow-same-version

                            npm publish \
                                --registry "${NEXUS_URL}"
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo "Pipeline succeeded: ${APP_NAME} version ${ARTIFACT_VERSION} published to ${NEXUS_URL}"
        }

        failure {
            echo "Pipeline FAILED: ${APP_NAME} build ${BUILD_NUMBER} - check logs at ${BUILD_URL}"
        }

        changed {
            echo "Build status changed to ${currentBuild.currentResult} - ${JOB_NAME} #${BUILD_NUMBER}"
        }
    }
}