pipeline {
    agent {
        docker {
            image 'node:18-alpine'
            args  '-v /tmp:/tmp --network=host'
        }
    }

    environment {
        NODE_ENV  = 'test'
        BUILD_DIR = 'dist'
        APP_NAME  = 'kijanikiosk-payments'
        NEXUS_URL        = 'http://13.245.143.159:8081/repository/npm-kijanikiosk'
        NPM_CONFIG_CACHE = "${WORKSPACE}/.npm"

    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Initialize') {
            steps {
                dir('week5/friday/kijanikiosk-payment') {
                    script {
                        env.PKG_VERSION = sh(
                            script: "node -p \"require('./package.json').version\"",
                            returnStdout: true
                        ).trim()

                        env.GIT_SHORT = env.GIT_COMMIT.take(7)

                        env.ARTIFACT_VERSION =
                            "${env.PKG_VERSION}-${env.GIT_SHORT}"

                        echo "Package version: ${env.PKG_VERSION}"
                        echo "Git commit: ${env.GIT_SHORT}"
                        echo "Artifact version: ${env.ARTIFACT_VERSION}"
                    }
                }
            }
        }
        stage('Lint') {
            steps {
                dir('week5/friday/kijanikiosk-payment') {
                    sh '''
                        rm -rf node_modules
                        npm ci
                        npm run lint
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('week5/friday/kijanikiosk-payment') {
                    sh 'npm run build'

                    sh '''
                        if [ ! -d "$BUILD_DIR" ] || [ -z "$(ls -A "$BUILD_DIR")" ]; then
                            echo "Build output directory $BUILD_DIR not found or empty"
                            exit 1
                        fi
                    '''

                    stash name: 'build-output',
                        includes: 'dist/**'
                }
            }
        }

        stage('Verify') {
            parallel {
                stage('Test') {
                    steps {
                        dir('week5/friday/kijanikiosk-payment') {
                            unstash 'build-output'
                            sh '''
                                set -e
                                npm test
                            '''
                        post {
                            always {
                                junit allowEmptyResults: true, testResults: 'test-results/*.xml'
                    }
                }
            }
        }
        stage('Security Audit') {
            steps {
                sh 'npm audit --audit-level=high'
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${BUILD_DIR}/**",
                                 fingerprint: true,
                                 onlyIfSuccessful: true
            }
        }

        stage('Publish') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-credentials',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    sh '''
                        set -e
                        trap "rm -f .npmrc" EXIT

                        NEXUS_TOKEN=$(printf "%s:%s" "$NEXUS_USER" "$NEXUS_PASS" | base64 | tr -d '\\n')
                        NEXUS_HOST=$(echo "$NEXUS_URL" | sed -E 's#^https?://##')

                        cat > .npmrc <<EOF
registry=$NEXUS_URL/
//$NEXUS_HOST/:_auth=$NEXUS_TOKEN
always-auth=true
EOF

                        npm version "$ARTIFACT_VERSION" --no-git-tag-version --allow-same-version
                        npm publish
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Published ${APP_NAME} version ${ARTIFACT_VERSION} to Nexus"
            echo "Artifact URL: ${NEXUS_URL}/kijanikiosk-payments/-/kijanikiosk-payments-${ARTIFACT_VERSION}.tgz"
        }
        failure {
            echo "Pipeline FAILED at build ${BUILD_NUMBER} - check logs at ${BUILD_URL}"
        }
        changed {
            echo "Build status changed to ${currentBuild.currentResult} - ${JOB_NAME} #${BUILD_NUMBER}"
        }
        always {
            cleanWs()
        }
    }
}
}